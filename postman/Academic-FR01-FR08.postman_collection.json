  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.collectionVariables.set('today', now.toISOString().slice(0,10));",
          "pm.collectionVariables.set('thisMonth', now.toISOString().slice(0,7));"
        ]
      }
    }
  ],
