          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// TypeCategory는 학원 전체가 공유하는 마스터 데이터라 이름이 유니크해야 한다.",
                "// 이미 존재하면(재실행 시 422) 목록에서 같은 이름을 찾아 그 id를 재사용한다(get-or-create).",
                "if (pm.response.code === 201) {",
                "    pm.test('Status 201 (신규 생성)', function () { pm.response.to.have.status(201); });",
                "    var json = pm.response.json();",
                "    pm.collectionVariables.set('typeCategoryId', json.data.id);",
                "} else {",
                "    pm.test('이미 존재하면 422 (재실행 시 정상)', function () { pm.expect(pm.response.code).to.equal(422); });",
                "    pm.sendRequest({",
                "        url: pm.collectionVariables.get('baseUrl') + '/v1/type-categories',",
                "        method: 'GET'",
                "    }, function (err, res) {",
                "        var found = res.json().data.find(function (c) { return c.name === '어휘'; });",
                "        if (found) { pm.collectionVariables.set('typeCategoryId', found.id); }",
                "    });",
                "}"
              ]
            }
          }]
